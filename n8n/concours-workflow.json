    {
      "parameters": {
        "jsCode": "// Vérifie et met en forme l'inscription au jeu concours\nconst b = $input.first().json.body || {};\nif (b.website) throw new Error('Inscription ignorée (anti-spam)');\nconst clean = (v, max = 160) => String(v ?? '').replace(/\\s+/g, ' ').trim().slice(0, max);\nconst d = {\n  name: clean(b.name, 120),\n  email: clean(b.email).toLowerCase(),\n  phone: clean(b.phone, 40),\n  list: clean(b.list, 60) || 'Leclercq des étoiles',\n  contest: clean(b.contest, 120) || 'Jeu concours',\n};\nif (!d.name || !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(d.email)) throw new Error('Inscription incomplète');\nd.date = new Date().toLocaleString('fr-FR', { timeZone: 'Europe/Paris', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });\nreturn [{ json: d }];\n"
      },
      "id": "b9ab3aa3-6c8c-4d89-9d54-be6b7f0e14ba",
      "name": "Préparer l'inscription",
      "type": "n8n-nodes-base.code",
