    {
      "parameters": {
        "jsCode": "// Vérifie la déclaration envoyée par le site (cotisation ou soutien actif)\nconst b = $input.first().json.body || {};\nif (b.website) throw new Error('Envoi ignoré (anti-spam)');\nconst clean = (v, max = 120) => String(v ?? '').replace(/\\s+/g, ' ').trim().slice(0, max);\nconst date = new Date().toLocaleString('fr-FR', { timeZone: 'Europe/Paris', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });\nconst d = {\n  type: clean(b.type, 20),\n  id: clean(b.id, 20) || ('X-' + Date.now().toString(36).toUpperCase()),\n  firstName: clean(b.firstName, 60),\n  lastName: clean(b.lastName, 60),\n  date,\n};\nif (!d.firstName || !d.lastName) throw new Error('Prénom ou nom manquant');\n\nif (d.type === 'cotisation') {\n  d.room = clean(b.room, 40);\n  const photo = String(b.photo || '');\n  const m = photo.match(/^data:image\\/(jpeg|jpg|png|webp);base64,([A-Za-z0-9+/=\\s]+)$/);\n  if (!d.room || !m) throw new Error('Chambre ou photo manquante');\n  if (m[2].length > 6000000) throw new Error('Photo trop lourde');\n  d.photo = m[2].replace(/\\s/g, '');\n  d.fileName = `${d.lastName}-${d.firstName}-${d.room}-${d.id}.jpg`.replace(/[^\\p{L}\\p{N}.\\-]+/gu, '_');\n  d.route = 0;\n} else if (d.type === 'soutien') {\n  d.goodies = clean(b.goodies, 500);\n  if (!d.goodies) throw new Error('Aucun goodie choisi');\n  d.route = 1;\n} else {\n  throw new Error('Type inconnu');\n}\nreturn [{ json: d }];\n"
      },
