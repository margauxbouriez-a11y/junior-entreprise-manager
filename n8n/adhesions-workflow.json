    {
      "parameters": {
        "jsCode": "// Met en forme les deux onglets pour l'Espace liste\nconst rows = (items) => items.map((i) => i.json || {}).filter((r) => String(r['ID'] || '').trim());\nconst cotisations = rows($('Lire les cotisations').all()).map((r) => ({\n  id: String(r['ID']), date: r['Date'] || '', firstName: r['Prénom'] || '', lastName: r['Nom'] || '',\n  room: r['Chambre'] || '', proof: r['Preuve'] || '', done: String(r['Livré'] || '').trim().toLowerCase() === 'oui',\n}));\nconst soutien = rows($input.all()).map((r) => ({\n  id: String(r['ID']), date: r['Date'] || '', firstName: r['Prénom'] || '', lastName: r['Nom'] || '',\n  goodies: r['Goodies'] || '', done: String(r['Donné'] || '').trim().toLowerCase() === 'oui',\n}));\nreturn [{ json: { ok: true, cotisations, soutien } }];\n"
      },
