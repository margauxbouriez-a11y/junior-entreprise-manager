    {
      "parameters": {
        "jsCode": "// Accès de l'Espace liste : la clé doit être la même que dans le site (onglet Cotisations)\n// ⚠️ Remplacez CHANGEZ-MOI par une clé longue et secrète (au moins 16 caractères).\nconst CLE_SECRETE = 'CHANGEZ-MOI';\n\nconst b = $input.first().json.body || {};\nconst ok = CLE_SECRETE !== 'CHANGEZ-MOI' && CLE_SECRETE.length >= 16 && String(b.key || '') === CLE_SECRETE;\nif (!ok) return [{ json: { route: 0 } }];\nconst action = String(b.action || 'list');\nif (action === 'set') {\n  const value = b.value === 'Oui' ? 'Oui' : 'Non';\n  const id = String(b.id || '').slice(0, 20);\n  if (!id) return [{ json: { route: 0 } }];\n  if (b.sheet === 'cotisations') return [{ json: { route: 2, id, value } }];\n  if (b.sheet === 'soutien') return [{ json: { route: 3, id, value } }];\n  return [{ json: { route: 0 } }];\n}\nreturn [{ json: { route: 1 } }];\n"
      },
