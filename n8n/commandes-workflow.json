    {
      "parameters": {
        "jsCode": "// Met en forme la commande envoyée par le site (tout est offert)\nconst b = $input.first().json.body || {};\n\n// Champ piège : seuls les robots le remplissent\nif (b.website) throw new Error('Commande ignorée (anti-spam)');\n\nconst clean = (v, max = 300) => String(v ?? '').replace(/\\s+/g, ' ').trim().slice(0, max);\nconst d = {\n  orderId: clean(b.orderId, 30) || 'LQ-?',\n  items: String(b.items ?? '').trim().slice(0, 2000),\n  count: clean(b.count, 4),\n  name: clean(b.name, 120),\n  email: clean(b.email, 160),\n  phone: clean(b.phone, 40),\n  where: clean(b.where, 200),\n  when: clean(b.when, 120) || 'Dès que possible',\n  notes: String(b.notes ?? '').trim().slice(0, 1000),\n  list: clean(b.list, 60) || 'Leclercq des étoiles',\n};\nif (!d.name || !d.where || !d.items) throw new Error('Commande incomplète');\nif (d.email && !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(d.email)) d.email = '';\n\nconst recu = new Date().toLocaleString('fr-FR', { timeZone: 'Europe/Paris', weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });\n\nconst subject = `[Commande ${d.orderId}] ${d.name} — ${d.where}`;\nconst text = [\n  `Nouvelle commande reçue sur le site, ${recu}.`,\n  '',\n  `N° de commande : ${d.orderId}`,\n  '',\n  d.items,\n  '',\n  `Livrer à : ${d.where}`,\n  `Quand     : ${d.when}`,\n  `Qui       : ${d.name}`,\n  `Téléphone : ${d.phone || '—'}`,\n  `E-mail    : ${d.email || '—'}`,\n  '',\n  d.notes ? `Précisions :\\n${d.notes}` : 'Pas de précisions.',\n  '',\n  \"Répondez directement à ce mail pour écrire à l'étudiant.\",\n].join('\\n');\n\nconst confirmSubject = `${d.list} — commande ${d.orderId} bien reçue`;\nconst confirmText = [\n  `Bonjour ${d.name.split(' ')[0]},`,\n  '',\n  `Votre commande ${d.orderId} est bien arrivée :`,\n  '',\n  d.items,\n  '',\n  `Livraison : ${d.where} · ${d.when}`,\n  '',\n  \"C'est offert par la liste ! Un membre vous livre très vite.\",\n  '',\n  `La liste ${d.list}`,\n].join('\\n');\n\n// Une ligne par commande pour Google Sheets\nconst date = new Date().toLocaleString('fr-FR', { timeZone: 'Europe/Paris', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });\nconst articles = d.items.split('\\n').filter(Boolean).join(', ');\n\nreturn [{ json: { ...d, date, articles, subject, text, confirmSubject, confirmText } }];\n"
      },
      "id": "f88b70b5-cf40-4d5b-be4d-dbd67a73b528",
      "name": "Préparer la commande",
